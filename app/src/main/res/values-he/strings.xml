    <string name="help_center">מרכז העזרה</string>
    <string name="help_center_summary">הסרת התקנה, חוסר תגובה, ניקוז סוללה</string>
    <string name="help_center_missing_permissions_text">כאשר הגדרה באפור ומבקשת ממך להפעיל משהו תחילה, עדיין לא הפעלת את ההרשאות הדרושות. כדי להעניק הרשאות חסרות פתח את הדף \"הרשאות\" בדף הראשי והסכם לשימוש בהרשאות הנדרשות. כעת תוכל להפעיל את ההגדרות הזקוקות להרשאות אלו.</string>
    <string name="help_center_uninstall">כיצד להסיר את ההתקנה</string>
    <string name="help_center_uninstall_text">תהליך הסרת ההתקנה עלול להיכשל בשל פגם בעיצוב של מערכת ההפעלה אנדרואיד. אם הרשאת מנהל המכשיר לא בוטלה לפני הסרת ההתקנה, התהליך ייכשל. עליך לבטל את הרשאת מנהל המכשיר לפני הסרת ההתקנה.</string>
    <string name="help_center_uninstall_button">הסר התקנה כעת</string>
    <string name="help_center_delays">כיצד לתקן עיכובים</string>
    <string name="help_center_delays_text">חלק מהיצרנים מעדיפים חיי סוללה על פני פונקציונליות האפליקציה, וזו הסיבה שאפליקציה זו עשויה לפעול רק עם עיכובים או בכלל לא במכשירים מסוימים. אם אתה חווה עיכובים, נסה לבטל אופטימיזציות סוללה עבור האפליקציה או בדוק הגדרות ספציפיות אחרות של היצרן.</string>
    <string name="help_center_delays_button_one">הגדרות סוללה</string>
    <string name="help_center_delays_button_two">ספציפי ליצרן</string>
    <string name="help_center_battery_drain">בירור מקור ניקוז הסוללה</string>
    <string name="help_center_battery_drain_text">סיבה אחת לניקוז הסוללה יכולה להיות שאתה משתמש בטלפון עם מסך LCD. אפליקציה זו מיועדת לטלפונים עם מסך OLED שיכולים לכבות פיקסלים שחורים כדי לחסוך באנרגיה. מסכי LCD אינם יכולים לכבות פיקסלים שחורים, מה שייגרם לכך שהמסך ישתמש בהרבה יותר אנרגיה כאשר Peek Display מופעל. סיבה נוספת יכולה להיות שאפליקציות אחרות פועלות ברקע בזמן ש-Peek Display פועל. אנדרואיד תציג את צריכת הסוללה שלהן כחלק מצריכת הסוללה של Peek Display.</string>

